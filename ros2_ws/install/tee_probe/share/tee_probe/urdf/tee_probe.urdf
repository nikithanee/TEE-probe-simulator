<?xml version="1.0"?>
<robot name="tee_probe" xmlns:xacro="http://www.ros.org/wiki/xacro">

  

  
  <material name="dark_gray">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="light_gray">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>
  <material name="yellow">
    <color rgba="0.9 0.8 0.0 1.0"/>
  </material>
  <material name="white">
    <color rgba="0.95 0.95 0.95 1.0"/>
  </material>

  
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.018"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.018"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      
      <inertia ixx="0.000975" ixy="0.0" ixz="0.0"
               iyy="0.000975" iyz="0.0"
               izz="0.0000486"/>
    </inertial>
  </link>

  
  <joint name="base_to_world" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
  </joint>

  
  <link name="world"/>

  
  <joint name="insertion_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="gastroscope_tube"/>
    <origin xyz="0 0 0.075" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.4" effort="20.0" velocity="0.2"/>
    <dynamics damping="0.5" friction="0.2"/>
  </joint>

  
  <link name="gastroscope_tube">
    <visual>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.4" radius="0.006"/>
      </geometry>
      <material name="light_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.4" radius="0.006"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.000670" ixy="0.0" ixz="0.0"
               iyy="0.000670" iyz="0.0"
               izz="0.0000009"/>
    </inertial>
  </link>

  
  <joint name="axial_rotation_joint" type="continuous">
    <parent link="gastroscope_tube"/>
    <child link="rotating_section"/>
    <origin xyz="0 0 0.38" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  
  <link name="rotating_section">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.008"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.008"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.0000022" ixy="0.0" ixz="0.0"
               iyy="0.0000022" iyz="0.0"
               izz="0.00000032"/>
    </inertial>
  </link>

  
  <joint name="large_wheel_joint" type="revolute">
    <parent link="rotating_section"/>
    <child link="large_wheel_section"/>
    <origin xyz="0 0 0.035" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="5.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  
  <link name="large_wheel_section">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.007"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.007"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <mass value="0.008"/>
      <inertia ixx="0.0000015" ixy="0.0" ixz="0.0"
               iyy="0.0000015" iyz="0.0"
               izz="0.000000196"/>
    </inertial>
  </link>

  
  <joint name="small_wheel_joint" type="revolute">
    <parent link="large_wheel_section"/>
    <child link="small_wheel_section"/>
    <origin xyz="0 0 0.035" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="5.0" velocity="1.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  
  <link name="small_wheel_section">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.006"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.03" radius="0.006"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="0.0000007" ixy="0.0" ixz="0.0"
               iyy="0.0000007" iyz="0.0"
               izz="0.000000090"/>
    </inertial>
  </link>

  
  <joint name="tip_joint" type="fixed">
    <parent link="small_wheel_section"/>
    <child link="ultrasound_tip"/>
    <origin xyz="0 0 0.035" rpy="0 0 0"/>
  </joint>

  <link name="ultrasound_tip">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.008 0.02"/>
      </geometry>
      <material name="yellow"/>
    </visual>
    <visual name="rotation_marker">
      	<origin xyz="0.0235 0 0.010" rpy="0 0 0"/>
      	<geometry>
            <box size="0.035 0.005 0.005"/>
      	</geometry>
      	<material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.008 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <mass value="0.003"/>
      <inertia ixx="0.000000148" ixy="0.0" ixz="0.0"
               iyy="0.000000208" iyz="0.0"
               izz="0.000000120"/>
    </inertial>
  </link>

  
  <ros2_control name="tee_probe_system" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    
    <joint name="insertion_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.4</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    
    <joint name="axial_rotation_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    
    <joint name="large_wheel_joint">
      <command_interface name="position">
        <param name="min">-1.5708</param>
        <param name="max">1.5708</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    
    <joint name="small_wheel_joint">
      <command_interface name="position">
        <param name="min">-1.5708</param>
        <param name="max">1.5708</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

  </ros2_control>

  
  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>/uio/hume/student-u78/nikithan/tee_probe_ws/ros2_ws/install/tee_probe/share/tee_probe/config/tee_controllers.yaml</parameters>
      <ros>
        <remapping>~/out:=joint_states</remapping>
      </ros>
    </plugin>
  </gazebo>

  
  <gazebo reference="base_link">
    <material>Gazebo/DarkGray</material>
  </gazebo>
  <gazebo reference="gastroscope_tube">
    <material>Gazebo/Gray</material>
  </gazebo>
  <gazebo reference="rotating_section">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="large_wheel_section">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="small_wheel_section">
    <material>Gazebo/Red</material>
  </gazebo>
  <gazebo reference="ultrasound_tip">
    <material>Gazebo/Yellow</material>
  </gazebo>

</robot>
